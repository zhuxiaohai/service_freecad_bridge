# Default FreeCAD AppImage split mirror for corporate/Jenkins builds (public Gitee).
# Sourced before deploy/.env so local overrides still work.
# Jenkins plain `docker build` uses the same values as ARG defaults in Dockerfile.
APPIMAGE_PARTS_PREFIX=https://gitee.com/xiaohaizhu/freecad-appimage-mirror/releases/download/freecad-appimage-1.1.1/part_
APPIMAGE_PART_COUNT=18
APPIMAGE_SHA256=e2006138400b2fa85fa2e160e872d00767eb32964e85075830f7e198a3a876e1  # pragma: allowlist secret

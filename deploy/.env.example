# Environment variables for deploy/docker-compose.yml
# Copy to deploy/.env: cp deploy/.env.example deploy/.env
#
# REQUIRED: FREECAD_BRIDGE_IMAGE must be set for compose build/run/push.

# =============================================================================
# Bridge image tag
# =============================================================================
#
# Tag policy:
#   dev     Mutable dev/staging tag (overwrite with just docker::publish-dev)
#   X.Y.Z   Immutable release (just docker::publish 1.0.0)
#
# Corporate registry (DesignOrder / Jenkins / K8s):
FREECAD_BRIDGE_IMAGE=hub.designorder.cn/freecad-bridge:dev
#
# Local build only (no registry):
# FREECAD_BRIDGE_IMAGE=freecad-bridge:latest

# =============================================================================
# Base image registry (Dockerfile FROM lines)
# =============================================================================
# Corporate mirror prefix. Empty = pull from Docker Hub (ubuntu:24.04).
DOCKER_REGISTRY=hub.designorder.cn/

# Ubuntu apt mirror (archive.ubuntu.com). Empty = use default Ubuntu CDN.
APT_MIRROR=http://mirrors.aliyun.com/ubuntu/

# =============================================================================
# FreeCAD AppImage version (Dockerfile build arg)
# =============================================================================
FREECAD_TAG=1.1.1

# =============================================================================
# FreeCAD AppImage mirror (optional overrides)
# =============================================================================
# Jenkins / corporate CI: zero config — defaults are baked into Dockerfile and
# deploy/appimage-mirror.env (public Gitee split mirror, no download token).
#
# Override only for a different mirror (e.g. faster GitLab Generic Packages):
# APPIMAGE_PARTS_PREFIX=https://git.designorder.cn/api/v4/projects/1031/packages/generic/freecad-appimage/1.1.1/part_
# APPIMAGE_PART_COUNT=18
# APPIMAGE_SHA256=e2006138400b2fa85fa2e160e872d00767eb32964e85075830f7e198a3a876e1
# APPIMAGE_DOWNLOAD_TOKEN=<gitlab token>
# APPIMAGE_DOWNLOAD_TOKEN_TYPE=private
#
# Upload new parts to Gitee (one-time per FreeCAD version):
#   GITEE_OWNER=your-gitee-username
#   GITEE_ACCESS_TOKEN=<gitee token with projects scope>
#   just docker::mirror-appimage

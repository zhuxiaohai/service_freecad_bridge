# Environment variables for deploy/docker-compose.yml
# Copy to deploy/.env: cp deploy/.env.example deploy/.env
#
# REQUIRED: FREECAD_BRIDGE_IMAGE must be set for compose build/run/push.

# =============================================================================
# Bridge image tag
# =============================================================================
#
# Tag policy:
#   dev     Mutable dev/staging tag (overwrite with just docker::publish-dev)
#   X.Y.Z   Immutable release (just docker::publish 1.0.0)
#
# Corporate registry (DesignOrder / Jenkins / K8s):
FREECAD_BRIDGE_IMAGE=hub.designorder.cn/freecad-bridge:dev
#
# Local build only (no registry):
# FREECAD_BRIDGE_IMAGE=freecad-bridge:latest

# =============================================================================
# Base image registry (Dockerfile FROM lines)
# =============================================================================
# Corporate mirror prefix. Empty = pull from Docker Hub (ubuntu:24.04).
DOCKER_REGISTRY=hub.designorder.cn/

# Ubuntu apt mirror (archive.ubuntu.com). Empty = use default Ubuntu CDN.
APT_MIRROR=http://mirrors.aliyun.com/ubuntu/

# =============================================================================
# FreeCAD AppImage version (Dockerfile build arg)
# =============================================================================
FREECAD_TAG=1.1.1
